# Email Configuration
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password

# Newsletter Sender Domains (comma-separated)
NEWSLETTER_SENDERS=@mail.theresanaiforthat.com,@medium.com,@skool.com,@mail.beehiiv.com,@substack.com,@llamaindex.ai

# AI Configuration (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Notification Configuration
NOTIFICATION_EMAIL=your-email@gmail.com

# Research Agent (optional — enriches summaries with web research)
RESEARCH_AGENT_ENABLED=false
RESEARCH_MODEL=meta-llama/llama-3.3-70b-instruct
RESEARCH_SEARCH_MODEL=perplexity/sonar-pro
RESEARCH_MAX_SEARCHES=5

# Timezone
TZ=Asia/Kolkata

# Summary Time (for reference, actual scheduling in GitHub Actions)
SUMMARY_TIME_IST=00:00
